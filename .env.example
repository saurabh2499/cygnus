# Copy to .env and fill in. .env is git-ignored.

# Required: Anthropic API key for the Claude-powered agents.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables live, location-aware vendor discovery (nearby + trending
# restaurants/cafes via web search). Without it, the engine uses the seeded
# catalog. Get a key at https://app.tavily.com
# TAVILY_API_KEY=tvly-...

# Database backend: "sqlite" (local dev, default) or "firestore" (GCP/Cloud Run).
# DB_BACKEND=sqlite

# SQLite only: database file location. Defaults to cygnus/requirements.db.
# VENDOR_DB_PATH=/absolute/path/to/vendor_management.db

# Firestore only (set DB_BACKEND=firestore). On Cloud Run auth is automatic;
# locally point at the emulator.
# GOOGLE_CLOUD_PROJECT=your-project
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Model provider: "anthropic" (local dev, default) or "gemini" (competition).
# MODEL_PROVIDER=anthropic

# Optional: cron tuning (defaults shown)
# CRON_INTERVAL=30
# CRON_MAX_CONCURRENCY=5
# CRON_BATCH=10
# CRON_MAX_RETRIES=3
# CRON_RETRY_BACKOFF=60
